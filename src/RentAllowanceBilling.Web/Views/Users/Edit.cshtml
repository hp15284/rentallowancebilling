@model RentAllowanceBilling.Web.Models.ViewModels.EditUserRolesViewModel
@{
    ViewData["Title"] = "Edit User";
}

<h2>Edit User: @Model.Email</h2>
<hr />
<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Email" />

    <div class="mb-3">
        <label asp-for="BranchId" class="form-label">Branch</label>
        <select asp-for="BranchId" class="form-select" asp-items="@(new SelectList(Model.Branches, "Id", "Name"))">
            <option value="">-- None --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Roles</label>
        @foreach (var role in Model.AllRoles)
        {
            <div class="form-check">
                <input type="checkbox" class="form-check-input" name="selectedRoles" value="@role" id="role_@role"
                       checked="@(Model.SelectedRoles.Contains(role))" />
                <label class="form-check-label" for="role_@role">@role</label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
