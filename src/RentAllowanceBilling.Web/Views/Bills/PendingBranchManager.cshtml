@model List<RentAllowanceBilling.Web.Models.RentAllowanceBill>
@{
    ViewData["Title"] = "Pending Branch Manager Recommendation";
}

<h2>Pending Branch Manager Recommendation</h2>
<hr />

<table class="table table-striped">
    <thead>
        <tr>
            <th>Bill No.</th>
            <th>Employee</th>
            <th>Branch</th>
            <th>Period</th>
            <th>Amount (Rs.)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bill in Model)
        {
            <tr>
                <td>@bill.BillNumber</td>
                <td>@bill.Employee?.FullName</td>
                <td>@bill.Branch?.Name</td>
                <td>@bill.PeriodFrom.ToString("dd-MMM-yyyy") - @bill.PeriodTo.ToString("dd-MMM-yyyy")</td>
                <td>@bill.TotalAmount.ToString("0.00")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-primary">Review</a>
                </td>
            </tr>
        }
    </tbody>
</table>
