@model List<RentAllowanceBilling.Web.Models.RentAllowanceBill>
@{
    ViewData["Title"] = "Draft Bills";
}

<div class="d-flex justify-content-between align-items-center">
    <h2>Draft Bills</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Bill</a>
</div>
<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Period</th>
            <th>Purpose</th>
            <th>Amount (Rs.)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bill in Model)
        {
            <tr>
                <td>@bill.Employee?.FullName</td>
                <td>@bill.PeriodFrom.ToString("dd-MMM-yyyy") - @bill.PeriodTo.ToString("dd-MMM-yyyy")</td>
                <td>@bill.PurposeOfVisit</td>
                <td>@bill.TotalAmount.ToString("0.00")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-primary">View</a>
                    <form asp-action="Submit" asp-route-id="@bill.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success">Submit</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
