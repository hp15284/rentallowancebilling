@model RentAllowanceBilling.Web.Models.ViewModels.TripRowViewModel
@{
    var index = ViewData["Index"];
    string Name(string field) => $"Trips[{index}].{field}";
}
<tr>
    <td><input type="date" name="@Name("TravelDate")" value="@(Model.TravelDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></td>
    <td><input type="text" name="@Name("FromPlace")" value="@Model.FromPlace" class="form-control form-control-sm" /></td>
    <td><input type="text" name="@Name("ToPlace")" value="@Model.ToPlace" class="form-control form-control-sm" /></td>
    <td><input type="time" name="@Name("DepartureTime")" value="@Model.DepartureTime" class="form-control form-control-sm" /></td>
    <td><input type="time" name="@Name("ReturnTime")" value="@Model.ReturnTime" class="form-control form-control-sm" /></td>
    <td><input type="number" step="0.01" min="0" name="@Name("Fare")" value="@Model.Fare" class="form-control form-control-sm trip-fare" /></td>
    <td><input type="number" step="0.01" min="0" name="@Name("Allowance")" value="@Model.Allowance" class="form-control form-control-sm trip-allowance" /></td>
    <td class="align-middle trip-total">@((Model.Fare + Model.Allowance).ToString("0.00"))</td>
    <td class="align-middle"><button type="button" class="btn btn-sm btn-outline-danger removeRowBtn">&times;</button></td>
</tr>
