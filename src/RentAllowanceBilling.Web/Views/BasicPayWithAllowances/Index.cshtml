@model List<RentAllowanceBilling.Web.Models.BasicPayWithAllowance>
@{
    ViewData["Title"] = "Basic Pay Allowance Slabs";
}

<div class="d-flex justify-content-between align-items-center">
    <h2>Basic Pay Allowance Slabs</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Slab</a>
</div>
<hr />

<table class="table table-striped">
    <thead><tr><th>Min Basic Pay</th><th>Max Basic Pay</th><th>Allowance Amount</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.MinBasicPay.ToString("N2")</td>
                <td>@(s.MaxBasicPay is null ? "and above" : s.MaxBasicPay.Value.ToString("N2"))</td>
                <td>@s.AllowanceAmount.ToString("N2")</td>
                <td>@(s.IsActive ? "Active" : "Inactive")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
