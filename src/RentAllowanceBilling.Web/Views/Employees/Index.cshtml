@model List<RentAllowanceBilling.Web.Models.Employee>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center">
    <h2>Employees</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Employee</a>
</div>
<hr />

<table class="table table-striped">
    <thead><tr><th>Name</th><th>PF No.</th><th>Designation</th><th>Branch</th><th>Basic Salary</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.FullName</td>
                <td>@e.PfNumber</td>
                <td>@e.Designation</td>
                <td>@e.Branch?.Name</td>
                <td>@e.BasicSalary.ToString("0.00")</td>
                <td>@(e.IsActive ? "Active" : "Inactive")</td>
                <td><a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
            </tr>
        }
    </tbody>
</table>
