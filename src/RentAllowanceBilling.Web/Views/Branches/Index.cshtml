@model List<RentAllowanceBilling.Web.Models.Branch>
@{
    ViewData["Title"] = "Branches";
}

<div class="d-flex justify-content-between align-items-center">
    <h2>Branches</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Branch</a>
</div>
<hr />

<table class="table table-striped">
    <thead><tr><th>Code</th><th>Name</th><th>Location</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Code</td>
                <td>@b.Name</td>
                <td>@b.Location</td>
                <td>@(b.IsActive ? "Active" : "Inactive")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="ToggleActive" asp-route-id="@b.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(b.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
